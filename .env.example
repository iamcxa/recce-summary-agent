# ============================================================================
# Required Configuration
# ============================================================================

# Claude API Key (required)
ANTHROPIC_API_KEY=

# Git Provider Token (required)
# This token will be used for authentication based on the repo URL provided via CLI
# - For GitHub repos: Use GitHub Personal Access Token
# - For GitLab repos: Use GitLab Personal Access Token
# - For Bitbucket repos: Use Bitbucket App Password
GIT_TOKEN=


# ============================================================================
# Optional Configuration
# ============================================================================

# Claude Model (default: claude-haiku-4-5-20251001)
# CLAUDE_MODEL=claude-haiku-4-5-20251001

# Recce Integration (default: enabled)
# RECCE_ENABLED=true
# RECCE_PROJECT_PATH=/path/to/your/dbt/project
# RECCE_YAML_PATH=  # Optional: path to recce.yml, defaults to RECCE_PROJECT_PATH/recce.yml
# RECCE_EXECUTE_PRESET_CHECKS=true
# RECCE_TARGET_PATH=target
# RECCE_TARGET_BASE_PATH=target-base

# Debug Mode (default: false)
# DEBUG=false

# Logging Configuration
# LOG_PRETTY=true
