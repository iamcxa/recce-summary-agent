{
  "name": "claude-pr-summary-agent",
  "version": "0.1.0",
  "description": "TypeScript-based Claude Agent application that generates PR summaries with dbt metadata analysis",
  "type": "module",
  "main": "dist/recce-agent",
  "bin": {
    "recce-agent": "./dist/recce-agent"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node18 --format=esm --outfile=dist/recce-agent --banner:js=\"#!/usr/bin/env node\" --external:commander --external:@anthropic-ai/claude-agent-sdk --external:dotenv --external:js-yaml --external:pino --external:pino-pretty",
    "dev": "tsx src/index.ts",
    "summary": "tsx src/index.ts",
    "start": "node dist/recce-agent",
    "type-check": "tsc --noEmit",
    "link": "pnpm link --global",
    "unlink": "pnpm unlink --global",
    "lint": "biome check --write src/",
    "lint:check": "biome check src/",
    "format": "biome format --write src/",
    "format:check": "biome format src/",
    "check": "biome check --write src/ && tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.1.30",
    "@anthropic-ai/sdk": "^0.68.0",
    "@modelcontextprotocol/server-github": "^2025.4.8",
    "@types/js-yaml": "^4.0.9",
    "commander": "^14.0.2",
    "dotenv": "^17.2.3",
    "js-yaml": "^4.1.0",
    "octokit": "^5.0.5",
    "pino": "^10.0.0",
    "pino-pretty": "^13.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.5",
    "@types/commander": "^2.12.5",
    "@types/node": "^24.10.0",
    "esbuild": "^0.27.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
