{
  "name": "claude-pr-summary-agent",
  "version": "0.1.0",
  "description": "TypeScript-based Claude Agent application that generates PR summaries with dbt metadata analysis",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js",
    "dev": "tsx src/index.ts",
    "summary": "tsx src/index.ts",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.1.30",
    "@anthropic-ai/sdk": "^0.68.0",
    "@modelcontextprotocol/server-github": "^2025.4.8",
    "@types/js-yaml": "^4.0.9",
    "dotenv": "^17.2.3",
    "js-yaml": "^4.1.0",
    "octokit": "^5.0.5",
    "pino": "^10.0.0",
    "pino-pretty": "^13.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "esbuild": "^0.27.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
